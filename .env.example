APP_ENV=production

HOST=127.0.0.1
PORT=8765

GLUCOSE_PROVIDER=librelinkup

LIBRELINK_EMAIL=
LIBRELINK_PASSWORD=
LIBRELINK_REGION=AUTO
LIBRELINK_BASE_URI=
LIBRELINK_PATIENT_ID=
LIBRELINK_CLIENT_VERSION=4.16.0

DATA_PATH=data/glucose.json.asc
SESSION_PATH=data/libre-session.json.asc
PGP_PUBLIC_KEY_PATH=data/keys/public.asc
PGP_PRIVATE_KEY_PATH=data/keys/private.asc

# Required: outbound snapshots are encrypted to this public key. The dashboard
# POSTs it to /api/keys after unlock.
PGP_USER_PUBLIC_KEY_PATH=data/keys/user-public.asc
# Never commit this value. php bin/init-pgp.php prompts for one when empty.
PGP_PASSPHRASE=

ABBOTT_POLL_SECONDS=60
BROWSER_POLL_SECONDS=5

# Loopback HTTP intake so the dashboard can hand the poller a LibreLinkUp
# login. `composer serve` (public/router.php) and host nginx/Caddy proxy
# /api/ here. Set AUTH_LISTEN= (empty) to disable.
# The password is used in RAM to obtain a session token and is not written
# to disk. LIBRELINK_EMAIL / LIBRELINK_PASSWORD in this file remain optional.
AUTH_LISTEN=127.0.0.1:8766

# Caddy site address for docker compose.
# :80 serves HTTP on the droplet IP.
# Set this to your hostname (glucose.example.com) after DNS points at the droplet
# so Caddy can obtain a Let's Encrypt certificate. Public-key enrollment and
# LibreLinkUp login from the dashboard require HTTPS.
GLUCHRON_SITE=:80
