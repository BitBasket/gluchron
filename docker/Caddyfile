{
	admin off
}

{$GLUCHRON_SITE:http://localhost} {
	root * /srv
	encode gzip zstd

	handle /api/* {
		reverse_proxy poller:8765 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
			header_up Host {host}
		}
	}

	# Plaintext snapshots are never served, even if an older deployment left
	# one on disk. Only the .asc ciphertext is reachable. This must precede the
	# catch-all file_server handle block below.
	@plaintext path_regexp plaintext (?i)^/(current|status|history|history-[0-9]{8}|b/[0-9]+)\.json$
	handle @plaintext {
		respond 404
	}

	handle {
		file_server
	}

	@snapshots path_regexp snapshots ^/(current|status|history-[0-9]{8}|b/[0-9]+)\.json(\.asc)?$
	header @snapshots Cache-Control "no-store"
	header @snapshots Content-Type "text/plain; charset=utf-8"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	log {
		output stdout
	}
}
