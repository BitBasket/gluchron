{
    "name": "bitbasket/gluchron",
    "description": "One-box self-host LibreLink glucose dashboard",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/BitBasket/gluchron-core.git"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "bitbasket/gluchron-core": "dev-trunk",
        "phpexperts/csv-speaker": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "init-pgp": "php bin/init-pgp.php",
        "migrate-history": "php bin/migrate-history.php",
        "poll": "php bin/poll-glucose.php",
        "serve": "php bin/serve.php",
        "start": "php bin/serve.php",
        "post-install-cmd": ["php bin/link-pwa.php"],
        "post-update-cmd": ["php bin/link-pwa.php"]
    },
    "config": {
        "sort-packages": true
    }
}
